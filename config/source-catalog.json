      "hosts": [
        "unison.betterlyrics.org"
      ],
      "changeReason": "2026-10-18 live ID 31 uses the publisher's new Composer TTML namespace; ID 1494 retains the legacy namespace. Compiled parser repair recognizes both explicit media-clock profiles and requires a compatible app release; extraction grammar and probes remain unchanged. Preserve source identities, attribution and raw timing; individual lyric-text rights remain unverified.",
      "extraction": {
        "search": {
          "url": "https://unison.betterlyrics.org/lyrics/search?q={query}",
          "response": "json",
          "itemsPath": "data",
          "fields": {
            "id": "id",
            "title": "song",
            "artist": "artist",
            "durationSeconds": "duration"
          }
        },
        "resolve": {
          "url": "https://unison.betterlyrics.org/lyrics/{id}",
          "response": "json",
          "rootPath": "data",
          "fields": {
            "body": "lyrics",
            "title": "song",
            "artist": "artist",
            "format": "format"
          }
        },
        "bodyFormat": "auto"
      },
